# Salin file ini menjadi .env.local. Aplikasi memakai proyek Firebase lama
# (kowawa-fee8c); hanya API key yang perlu diisi, dari Firebase Console
# (Project settings > Your apps > SDK setup and configuration).
# Selama API key kosong, aplikasi berjalan dalam mode demo:
# data contoh disimpan di browser dan tidak perlu login.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=kowawa-fee8c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kowawa-fee8c
VITE_FIREBASE_STORAGE_BUCKET=kowawa-fee8c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=369035690704
VITE_FIREBASE_APP_ID=1:369035690704:web:e7164c08c0177236fc94d5
